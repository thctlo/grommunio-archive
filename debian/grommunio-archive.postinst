#!/bin/sh
set -e

SETUID_TOOLS="pileraget pilerexport pilerget pilerimport pilerstats pilertest reindex"

#DEBHELPER#

case "$1" in
    configure)
        # The tools run as the archive user: setuid/setgid groarchive.
        for t in $SETUID_TOOLS; do
            f=/usr/bin/$t
            if ! dpkg-statoverride --list "$f" >/dev/null 2>&1; then
                dpkg-statoverride --update --add groarchive groarchive 6755 "$f"
            fi
        done
        # The package ships nginx and PHP-FPM configuration.
        if [ -d /run/systemd/system ]; then
            systemctl try-reload-or-restart nginx.service >/dev/null 2>&1 || true
            systemctl list-units --plain --no-legend --quiet 'php*-fpm.service' 2>/dev/null | \
                awk '{print $1}' | xargs -r systemctl try-restart >/dev/null 2>&1 || true
        fi

        # Upgrade the schema of an existing archive database. Ported from
        # upstream's own %post (grommunio-archive.spec, 2026-10 revision):
        # piler 1.4 renamed the `group` table to `usergroup` (the 1.4.9 webui
        # only knows the new name), widened audit.ipaddr for IPv6 and added
        # two metadata indexes. Upstream's own db-upgrade.sql cannot be used
        # here: it is not installed, and it only renames the table in a
        # database called "piler", which grommunio does not use.
        # db-upgrade-grommunio.sql is idempotent, so it is safe to run on
        # every install/upgrade. On our own fresh installs (via
        # grommunio-archive-setup, which always creates the current 1.4.9
        # schema directly) every check below is already satisfied and this
        # is a no-op - it only does real work on a database that still has
        # the older piler 1.3.x shape. An unreachable database must not fail
        # the package transaction, so explain how to apply it by hand.
        groarch_conf="/etc/grommunio-archive/grommunio-archive.conf"
        groarch_sql="/usr/share/grommunio-archive/db-upgrade-grommunio.sql"
        if [ -f "$groarch_conf" ] && [ -f "$groarch_sql" ]; then
            groarch_get () {
                if grep -q "^$1=" "$groarch_conf"; then
                    sed -n "s/^$1=//p" "$groarch_conf" | sed 's/\r.*//' | tail -n 1
                else
                    printf '%s' "$2"
                fi
            }
            groarch_dbhost=$(groarch_get mysqlhost "")
            groarch_dbport=$(groarch_get mysqlport "")
            groarch_dbsock=$(groarch_get mysqlsocket /tmp/mysql.sock)
            groarch_dbuser=$(groarch_get mysqluser piler)
            groarch_dbname=$(groarch_get mysqldb piler)
            groarch_client=$(command -v mariadb 2>/dev/null || command -v mysql 2>/dev/null)
            groarch_cnf=""
            if [ -z "$groarch_client" ]; then
                groarch_err="no mariadb/mysql client found"
            elif ! groarch_cnf=$(mktemp 2>/dev/null); then
                groarch_err="cannot create a temporary file"
                groarch_cnf=""
            else
                # Option file syntax: quote the value, escape backslashes/quotes.
                printf '[client]\npassword="%s"\n' \
                    "$(groarch_get mysqlpwd "" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')" \
                    > "$groarch_cnf"
                # --defaults-file must come first; it also keeps the client
                # from reading /etc/my.cnf and root's ~/.my.cnf.
                if groarch_err=$("$groarch_client" --defaults-file="$groarch_cnf" \
                    --connect-timeout=10 --socket="$groarch_dbsock" \
                    ${groarch_dbhost:+--host="$groarch_dbhost"} \
                    ${groarch_dbport:+--port="$groarch_dbport"} \
                    --user="$groarch_dbuser" --database="$groarch_dbname" \
                    < "$groarch_sql" 2>&1); then
                    groarch_err=""
                fi
            fi
            [ -z "$groarch_cnf" ] || rm -f -- "$groarch_cnf"
            if [ -n "$groarch_err" ]; then
                {
                    echo "grommunio-archive: could not upgrade the archive database schema:"
                    printf '%s\n' "$groarch_err" | sed 's/^/    /'
                    echo "Once the database is reachable, apply the upgrade with:"
                    echo "    mysql${groarch_dbhost:+ -h $groarch_dbhost} -u $groarch_dbuser -p $groarch_dbname < $groarch_sql"
                } >&2
            fi
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

exit 0
