[grommunio-archive-pool]
; socket information
listen = /run/php/php-grommunio-archive-fpm.sock
listen.mode = 0666
listen.owner = groarchive
listen.group = groarchive
listen.backlog = -1
; process privileges
user = groarchive
group = groarchive
; process management
pm = dynamic
pm.max_children = 35
pm.start_servers = 5
pm.min_spare_servers = 5
pm.max_spare_servers = 10
pm.max_requests = 200
; additional tunables
request_terminate_timeout = 120s
rlimit_files = 131072
rlimit_core = unlimited
; logging
catch_workers_output = yes
