Description: Do not chown to the piler user while building or installing (Debian's build runs unprivileged; ownership is set by the maintainer scripts).
Author: grommunio <dev@grommunio.com>
Origin: vendor
Forwarded: not-needed
Last-Update: 2026-09-24

--- a/Makefile.in	2026-06-30 02:03:50.498773348 +0200
+++ b/Makefile.in	2026-06-30 02:09:55.490378374 +0200
@@ -86,14 +86,14 @@
 		$(DESTDIR)$(localstatedir)/piler/export \
 		$(DESTDIR)$(localstatedir)/piler/manticore
 
-	$(INSTALL) -d -m 0755 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/run
-	$(INSTALL) -d -m 0700 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/store
-	$(INSTALL) -d -m 0700 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/imap
-	$(INSTALL) -d -m 0755 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/stat
-	$(INSTALL) -d -m 0711 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/tmp
-	$(INSTALL) -d -m 0711 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/error
-	$(INSTALL) -d -m 0700 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/export
-	$(INSTALL) -d -m 0700 -o $(RUNNING_USER) -g $(RUNNING_GROUP) $(DESTDIR)$(localstatedir)/piler/manticore
+	$(INSTALL) -d -m 0755 $(DESTDIR)$(localstatedir)/piler/run
+	$(INSTALL) -d -m 0700 $(DESTDIR)$(localstatedir)/piler/store
+	$(INSTALL) -d -m 0700 $(DESTDIR)$(localstatedir)/piler/imap
+	$(INSTALL) -d -m 0755 $(DESTDIR)$(localstatedir)/piler/stat
+	$(INSTALL) -d -m 0711 $(DESTDIR)$(localstatedir)/piler/tmp
+	$(INSTALL) -d -m 0711 $(DESTDIR)$(localstatedir)/piler/error
+	$(INSTALL) -d -m 0700 $(DESTDIR)$(localstatedir)/piler/export
+	$(INSTALL) -d -m 0755 $(DESTDIR)$(localstatedir)/piler/manticore
 
 
