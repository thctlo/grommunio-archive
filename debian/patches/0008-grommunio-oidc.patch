+   public function checkLoginOIDC($claims = array()) {
+      $role = 0;
+
+      $email = strtolower($claims['email'] ?? '');
+
+      if(!strchr($email, '@')) { $email = strtolower($claims['preferred_username'] ?? ''); }
+
+      if(!validemail($email)) { return array(); }
+
+      if(OIDC_ADMIN_CLAIM && filter_var($claims[OIDC_ADMIN_CLAIM] ?? false, FILTER_VALIDATE_BOOLEAN)) { $role = 1; }
+
+      $emails = array($email);
+
+      if(CUSTOM_EMAIL_QUERY_FUNCTION && function_exists(CUSTOM_EMAIL_QUERY_FUNCTION)) {
+         $result = call_user_func(CUSTOM_EMAIL_QUERY_FUNCTION, $email);
