diff -Naur a/piler-1.4.9/webui/system/oidc.php b/piler-1.4.9/webui/system/oidc.php
--- piler-1.4.9/webui/system/oidc.php	1970-01-01 01:00:00.000000000 +0100
+++ piler-1.4.9/webui/system/oidc.php	2026-09-16 15:02:35.251174000 +0200
@@ -0,0 +1,330 @@
+<?php
+
+/*
+ * OpenID Connect relying party for the login/oidc controller:
+ * authorization code flow with PKCE, id_token verification (RS256)
+ * and RP-initiated logout.
+ */
+
+class OIDC {
+   private $issuer;
+   private $client_id;
+   private $client_secret;
+   private $scope;
+   private $redirect_uri;
+   private $id_token = '';
+   private $error = '';
+
+
+   public function __construct() {
+      $this->issuer = rtrim(OIDC_ISSUER, '/');
+      $this->client_id = OIDC_CLIENT_ID;
+      $this->client_secret = OIDC_CLIENT_SECRET;
+      $this->scope = OIDC_SCOPE;
+      $this->redirect_uri = SITE_URL . 'index.php?route=login/oidc';
+   }
+
+
+   public function get_error() {
+      return $this->error;
+   }
+
+
+   public function get_id_token() {
+      return $this->id_token;
+   }
+
+
+   public function login_url() {
+      $session = Registry::get('session');
+
+      $config = $this->discovery();
+      if(!$config) { return ''; }
+
+      $state = bin2hex(random_bytes(16));
+      $nonce = bin2hex(random_bytes(16));
+      $verifier = $this->base64url_encode(random_bytes(32));
+
+      $session->set("oidc_state", $state);
+      $session->set("oidc_nonce", $nonce);
+      $session->set("oidc_verifier", $verifier);
+
+      $params = array(
+         'response_type' => 'code',
+         'client_id' => $this->client_id,
+         'redirect_uri' => $this->redirect_uri,
+         'scope' => $this->scope,
+         'state' => $state,
+         'nonce' => $nonce,
+         'code_challenge' => $this->base64url_encode(hash('sha256', $verifier, true)),
+         'code_challenge_method' => 'S256'
+      );
+
+      return $config['authorization_endpoint'] . '?' . http_build_query($params);
+   }
+
+
+   /*
+    * Exchange the authorization code for tokens, verify the id_token
+    * and return its claims merged with the userinfo response
+    */
+
+   public function handle_callback($code = '', $state = '') {
+      $session = Registry::get('session');
+
+      $expected_state = $session->get("oidc_state");
+      $nonce = $session->get("oidc_nonce");
+      $verifier = $session->get("oidc_verifier");
+
+      $session->remove("oidc_state");
+      $session->remove("oidc_nonce");
+      $session->remove("oidc_verifier");
+
+      if($code == '' || $state == '' || $expected_state == '' || !hash_equals($expected_state, $state)) {
+         $this->error = 'state mismatch';
+         return array();
+      }
+
+      $config = $this->discovery();
+      if(!$config) { return array(); }
+
+      $token = $this->http_request($config['token_endpoint'], array(
+         'grant_type' => 'authorization_code',
+         'code' => $code,
+         'redirect_uri' => $this->redirect_uri,
+         'client_id' => $this->client_id,
+         'client_secret' => $this->client_secret,
+         'code_verifier' => $verifier
+      ));
+
+      if(!isset($token['id_token']) || !isset($token['access_token'])) {
+         $this->error = 'token request failed' . (isset($token['error']) ? ': ' . $token['error'] : '');
+         return array();
+      }
+
+      $claims = $this->verify_id_token($token['id_token'], $config, $nonce);
+      if(!$claims) { return array(); }
+
+      if(isset($config['userinfo_endpoint'])) {
+         $userinfo = $this->http_request($config['userinfo_endpoint'], array(), $token['access_token']);
+
+         // OpenID Connect core 5.3.2: only trust userinfo for the same subject
+         if(isset($userinfo['sub']) && $userinfo['sub'] === $claims['sub']) {
+            $claims = array_merge($claims, $userinfo);
+         }
+      }
+
+      $this->id_token = $token['id_token'];
+
+      return $claims;
+   }
+
+
+   public function logout_url($id_token = '') {
+      $config = $this->discovery();
+
+      if(!isset($config['end_session_endpoint'])) { return ''; }
+
+      $params = array(
+         'client_id' => $this->client_id,
+         'post_logout_redirect_uri' => SITE_URL
+      );
+
+      if($id_token) { $params['id_token_hint'] = $id_token; }
+
+      return $config['end_session_endpoint'] . '?' . http_build_query($params);
+   }
+
+
+   // provider metadata, cached in the session for an hour
+
+   private function discovery() {
+      $session = Registry::get('session');
+
+      $cached = $session->get("oidc_discovery");
+
+      if(is_array($cached) && isset($cached['config']) && isset($cached['expires']) && $cached['expires'] > NOW) {
+         return $cached['config'];
+      }
+
+      $config = $this->http_request($this->issuer . '/.well-known/openid-configuration');
+
+      if(!isset($config['issuer']) || !isset($config['authorization_endpoint']) || !isset($config['token_endpoint']) || !isset($config['jwks_uri'])) {
+         $this->error = 'cannot fetch the openid configuration from ' . $this->issuer;
+         return array();
+      }
+
+      if(rtrim($config['issuer'], '/') != $this->issuer) {
+         $this->error = 'issuer mismatch: ' . $config['issuer'];
+         return array();
+      }
+
+      $session->set("oidc_discovery", array('expires' => NOW + 3600, 'config' => $config));
+
+      return $config;
+   }
+
+
+   private function verify_id_token($jwt = '', $config = array(), $nonce = '') {
+      $parts = explode('.', $jwt);
+
+      if(count($parts) != 3) {
+         $this->error = 'malformed id_token';
+         return array();
+      }
+
+      $header = json_decode($this->base64url_decode($parts[0]), true);
+      $claims = json_decode($this->base64url_decode($parts[1]), true);
+      $signature = $this->base64url_decode($parts[2]);
+
+      if(!is_array($header) || !is_array($claims) || $signature == '') {
+         $this->error = 'malformed id_token';
+         return array();
+      }
+
+      if(($header['alg'] ?? '') != 'RS256') {
+         $this->error = 'unsupported id_token algorithm: ' . ($header['alg'] ?? '');
+         return array();
+      }
+
+      $key = $this->get_signing_key($config['jwks_uri'], $header['kid'] ?? '');
+      if($key == '') { return array(); }
+
+      if(openssl_verify($parts[0] . '.' . $parts[1], $signature, $key, OPENSSL_ALGO_SHA256) !== 1) {
+         $this->error = 'invalid id_token signature';
+         return array();
+      }
+
+      if(rtrim($claims['iss'] ?? '', '/') != $this->issuer) {
+         $this->error = 'id_token issuer mismatch';
+         return array();
+      }
+
+      $aud = (array)($claims['aud'] ?? array());
+
+      if(!in_array($this->client_id, $aud, true) || (isset($claims['azp']) && $claims['azp'] !== $this->client_id)) {
+         $this->error = 'id_token audience mismatch';
+         return array();
+      }
+
+      if(!isset($claims['exp']) || $claims['exp'] < NOW) {
+         $this->error = 'id_token expired';
+         return array();
+      }
+
+      if($nonce == '' || !isset($claims['nonce']) || !hash_equals($nonce, (string)$claims['nonce'])) {
+         $this->error = 'id_token nonce mismatch';
+         return array();
+      }
+
+      if(!isset($claims['sub']) || $claims['sub'] === '') {
+         $this->error = 'id_token without subject';
+         return array();
+      }
+
+      return $claims;
+   }
+
+
+   // PEM encoded public key of the JWKS entry matching the token's kid
+
+   private function get_signing_key($jwks_uri = '', $kid = '') {
+      $jwks = $this->http_request($jwks_uri);
+
+      foreach($jwks['keys'] ?? array() as $jwk) {
+         if(($jwk['kty'] ?? '') != 'RSA' || !isset($jwk['n']) || !isset($jwk['e'])) { continue; }
+         if(isset($jwk['use']) && $jwk['use'] != 'sig') { continue; }
+         if($kid != '' && ($jwk['kid'] ?? '') != $kid) { continue; }
+
+         return $this->jwk_to_pem($jwk['n'], $jwk['e']);
+      }
+
+      $this->error = 'no matching signing key at ' . $jwks_uri;
+
+      return '';
+   }
+
+
+   // DER encode the RSA modulus and exponent as SubjectPublicKeyInfo for openssl_verify()
+
+   private function jwk_to_pem($n = '', $e = '') {
+      $rsa_public_key = $this->der("\x30", $this->der_integer($this->base64url_decode($n)) . $this->der_integer($this->base64url_decode($e)));
+
+      // rsaEncryption OID with NULL parameters
+      $algorithm = "\x30\x0d\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01\x05\x00";
+
+      $spki = $this->der("\x30", $algorithm . $this->der("\x03", "\x00" . $rsa_public_key));
+
+      return "-----BEGIN PUBLIC KEY-----\n" . chunk_split(base64_encode($spki), 64, "\n") . "-----END PUBLIC KEY-----\n";
+   }
+
+
+   private function der_integer($bytes = '') {
+      $bytes = ltrim($bytes, "\x00");
+
+      // a leading zero keeps values with the top bit set positive
+      if($bytes == '' || (ord($bytes[0]) & 0x80)) { $bytes = "\x00" . $bytes; }
+
+      return $this->der("\x02", $bytes);
+   }
+
+
+   private function der($tag = '', $content = '') {
+      $len = strlen($content);
+
+      if($len < 0x80) {
+         $length = chr($len);
+      }
+      else {
+         $bytes = ltrim(pack('N', $len), "\x00");
+         $length = chr(0x80 | strlen($bytes)) . $bytes;
+      }
+
+      return $tag . $length . $content;
+   }
+
+
+   private function http_request($url = '', $post = array(), $bearer = '') {
+      $ch = curl_init();
+
+      $headers = array('Accept: application/json');
+      if($bearer) { $headers[] = 'Authorization: Bearer ' . $bearer; }
+
+      curl_setopt($ch, CURLOPT_URL, $url);
+      curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
+      curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
+      curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 10);
+      curl_setopt($ch, CURLOPT_TIMEOUT, 30);
+
+      if(count($post) > 0) {
+         curl_setopt($ch, CURLOPT_POST, true);
+         curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($post));
+      }
+
+      if(defined('ENABLE_SSL_VERIFY') && ENABLE_SSL_VERIFY == 0) {
+         curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
+         curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
+      }
+
+      $ret = curl_exec($ch);
+
+      if($ret === false) {
+         $this->error = 'request to ' . $url . ' failed: ' . curl_error($ch);
+      }
+
+      $data = json_decode((string)$ret, true);
+
+      return is_array($data) ? $data : array();
+   }
+
+
+   private function base64url_encode($s = '') {
+      return rtrim(strtr(base64_encode($s), '+/', '-_'), '=');
+   }
+
+
+   private function base64url_decode($s = '') {
+      return (string)base64_decode(strtr($s, '-_', '+/'), true);
+   }
+
+}
