+            $emails = array_values(array_unique(array_merge($emails, $result)));
+         }
+      }
+
+      $extra_emails = $this->model_user_user->get_email_addresses_from_groups($emails);
+      $emails = array_merge($emails, $extra_emails);
+
+      $data = $this->fix_user_data($claims['name'] ?? $email, $email, $emails, $role);
+
+      $data['folders'] = $this->model_folder_folder->get_folder_id_array_for_user($data['uid'], $role);
