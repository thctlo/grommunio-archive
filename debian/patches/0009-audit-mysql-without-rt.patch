+            $results[] = array(
+               'id' => $a['meta_id'],
+               'piler_id' => '',
+               'action' => $a['action'],
+               'email' => htmlspecialchars($a['email']),
+               'date' => date(DATE_TEMPLATE . ' H:i', $a['ts']),
+               'ipaddr' => htmlspecialchars(DEMO_MODE == 1 ? anonimize_ip_addr($a['ipaddr']) : $a['ipaddr']),
+               'description' => $description,
+               'shortdescription' => make_short_string($description, MAX_CGI_FROM_SUBJ_LEN)
+            );
