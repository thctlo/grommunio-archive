+
+   private function print_audit_to_csv_sql() {
+      $actions = array_flip(Registry::get('actions'));
+
+      $a = $this->session->get('audit_query');
+
+      if(isset($a['where']) && isset($a['sortorder']) && isset($a['arr'])) {
+         print 'Date' . DELIMITER . 'ID' . DELIMITER . 'User' . DELIMITER . 'IP-address' . DELIMITER . 'Action' . DELIMITER . 'Piler ID' . DELIMITER . "Description\n";
+
+         $query = $this->db->query('SELECT * FROM ' . TABLE_AUDIT . ' ' . $a['where'] . ' ' . $a['sortorder'], $a['arr']);
+
+         foreach($query->rows as $q) {
+            if(DEMO_MODE == 1) { $q['ipaddr'] = anonimize_ip_addr($q['ipaddr']); }
+
+            print date(DATE_TEMPLATE . ' H:i:s', $q['ts']) . DELIMITER . $q['id'] . DELIMITER . $q['email'] . DELIMITER . $q['ipaddr'] . DELIMITER . $actions[$q['action']] . DELIMITER . $q['meta_id'] . DELIMITER . $q['description'] . "\n";
+         }
+      }
+   }
+
+
+   // The audit helper controller passes tab separated values; a '*' turns a
+   // value into a prefix match.
+   private function append_search_criteria_sql($field = '', $s = '', &$arr = array()) {
+      $str = '';
+
+      foreach(explode("\t", $s) as $v) {
+         if($v == '') { continue; }
+
+         if(strchr($v, '*')) {
+            $str .= " OR `$field` LIKE ?";
+            array_push($arr, preg_replace("/\*.*/", "%", $v));
+         }
+         else {
+            $str .= " OR `$field` = ?";
+            array_push($arr, $v);
+         }
+      }
+
+      return $str ? ' AND (' . substr($str, 4) . ')' : '';
+   }
+
+
+   private function count_recent_actions_sql($action = 0) {
+      $query = $this->db->query('SELECT COUNT(*) AS num FROM ' . TABLE_AUDIT . ' WHERE email=? AND ts > ? AND action=?', array($this->session->get('email'), NOW-3600, $action));
+
+      return isset($query->row['num']) ? (int)$query->row['num'] : 0;
+   }
+
 }
